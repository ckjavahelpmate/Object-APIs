	"item": [
		{
			"name": "POST Single Object",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test('Verify the status code', () => {",
							"    pm.expect(pm.response.code).to.eql(200);",
							"});",
							"",
							"pm.test('Verify the response time', () => {",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);",
							"});",
							"",
							"pm.test('verify required createdAt field', () => { ",
							"    pm.expect(jsonData).to.have.property('createdAt');",
							"});",
							"",
							"pm.test('Verify the Content type', () => {",
							"    pm.expect(pm.response.headers.get('Content-Type')).to.eql('application/json');",
							"});",
							"",
							"pm.collectionVariables.set('objectId', jsonData.id);",
							"",
							"// pm.execution.setNextRequest('verifyGetSingleObject')"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"\r",
							"// Generate Randome name\r",
							"let randomName = Math.random().toString(36).substring(2);\r",
							"pm.collectionVariables.set(\"objectName\", 'Apple ' + randomName);\r",
							"\r",
							"// Generate Randome Year\r",
							"let randomYear = Math.floor(Math.random() * 15) + 2010;\r",
							"pm.collectionVariables.set(\"objectYear\", randomYear );\r",
							"\r",
							"// Generate random model\r",
							"pm.collectionVariables.set('objectCPUModel', 'Intel - ' + randomYear) ;\r",
							"\r",
							"//Generate random hard disk size\r",
							"pm.collectionVariables.set('objectHardDiskSize', Math.floor(Math.random() * 10)+\" TB\");\r",
							"\r",
							"//Generate random price\r",
							"pm.collectionVariables.set('objectPrice', Number((Math.random() * 1000 + 100).toFixed(2)) ) ;\r",
							"\r",
							"\r",
							""
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n   \"name\": \"{{objectName}}\" ,\r\n   \"data\": {\r\n      \"year\": {{objectYear}},\r\n      \"price\": {{objectPrice}},\r\n      \"CPU model\": \"{{objectCPUModel}}\",\r\n      \"Hard disk size\": \"{{objectHardDiskSize}}\"\r\n   }\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{qaBaseURL}}/objects"
			},
			"response": []
		},
		{
			"name": "GET Single Object",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"const jsonData = pm.response.json();",
							"",
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response time is less than 1000ms\", function () {   ",
							"    pm.expect(pm.response.responseTime).to.be.below(1000);",
							"});",
							"",
							"pm.test('Validate JSON schema', () => {",
							"    const schema = JSON.parse(pm.collectionVariables.get(\"objectSchemaForGet\"));",
							"    pm.response.to.have.jsonSchema(schema);",
							"});",
							"",
							"pm.test('Object data is correct', ( )=> {",
							"    pm.expect(jsonData.name).to.eql(pm.collectionVariables.get(\"objectName\"));",
							"    pm.expect(jsonData.data.year).to.eql(pm.collectionVariables.get(\"objectYear\"));",
							"    pm.expect(jsonData.data.price).to.eql(pm.collectionVariables.get('objectPrice'));",
							"    pm.expect(jsonData.data['CPU model']).to.eql(pm.collectionVariables.get('objectCPUModel'));",
							"    pm.expect(jsonData.data['Hard disk size']).to.eql(pm.collectionVariables.get('objectHardDiskSize'));",
							"})"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": "https://api.restful-api.dev/objects/{{objectId}}"
			},
			"response": []
		},
